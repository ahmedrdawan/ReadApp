{
  "info": {
    "name": "Readify API",
    "_postman_id": "readify-collection",
    "description": "Minimal Postman collection for Readify mobile integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"user@example.com\", \"password\": \"password\" }"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Books - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/book?pageNumber=1&pageSize=10"
      }
    },
    {
      "name": "Categories - List",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/categories"
      }
    },
    {
      "name": "Categories - Create (Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{ \"name\": \"Fiction\", \"icon\": null }" },
        "url": "{{baseUrl}}/api/categories"
      }
    },
    {
      "name": "Categories - Update (Admin)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{ \"name\": \"Sci-Fi\", \"icon\": null }" },
        "url": "{{baseUrl}}/api/categories/{{categoryId}}"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "categoryId", "value": "" }
  ]
}
